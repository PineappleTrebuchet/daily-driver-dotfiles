# Variables
#
set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term alacritty
set $menu fuzzel

# Wallpaper
#
output * bg $HOME/Pictures/wallpapers/nature/moraine-lake2.jpg fill
#exec wpaperd -d

# Outputs

# Example configuration:
# output HDMI-A-1 resolution 1920x1080 position 1920,0
# You can get the names of your outputs by running: swaymsg -t get_outputs
output eDP-1 position 0 0
output * scale 1
workspace 1 output eDP-1


# Swayidle
#
exec swayidle -w \
    timeout 300 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
    timeout 600 'swaylock -f' \
    before-sleep 'swaylock -f'

# Input configuration
#
    input * {
        middle_emulation false
    }

    input type:touchpad {
        dwt enabled
        tap enabled
        natural_scroll enabled
        accel_profile "flat"
        pointer_accel 0.65
    }

    input type:pointer {
        #scroll_factor 1.2
    }

    input type:keyboard {
        repeat_delay 450
        repeat_rate 35
    }

    input 2:10:TPPS/2_Elan_TrackPoint {
        accel_profile "flat"
        pointer_accel 0.05
    }
 
# You can also configure each device individually.
# Read `man 5 sway-input` for more information about this section.
# Colors and Aesthetic:
#
client.focused          #0099ff #1b6698 #ffffff #0099ff #0099ff
client.focused_inactive #4c4c4c #3c3c3c #ffffff #272727 #272727
client.unfocused        #272727 #1f1f1f #ffffff #272727 #272727
client.urgent           #ff0000 #990000 #ffffff #ff0000 #ff0000

default_border pixel 1
default_floating_border pixel 1
gaps inner 4

# Waybar:
#
bar {
  swaybar_command waybar
}

# Miscellaneous:
# 
xwayland enable
focus_follows_mouse no
title_align center
exec swaync
exec autotiling
exec swayosd-server
font pango:"Adwaita Sans" 10
for_window [app_id="^.*"] inhibit_idle fullscreen
for_window [shell="xwayland"] title_format "%title (%shell)"
exec --no-startup-id /usr/bin/gnome-keyring-daemon --start

# These lines are useless (or cause problems) on NixOS
# so they are commented out
#
# seat seat0 xcursor_theme phinger-cursors-dark 24
# exec --no-startup-id /usr/lib/xdg-desktop-portal -r
# exec sh -c "$HOME/.config/swaync/swaync.sh"

# Force floating mode on specific windows:
# 
for_window [title="File Operation Progress"] floating enable
for_window [title="Confirm to replace files"] floating enable
for_window [title="Rename "] floating enable
for_window [title="Qalculate!"] floating enable
for_window [title="zoom"] floating enable
for_window [title="Choose a profile"] floating enable
for_window [title="Library"] floating enable
for_window [class="(?i)\.exe$"] floating enable
for_window [app_id="(?i)\.exe$"] floating enable
for_window [class="steam_app"] floating enable
for_window [app_id="steam_app"] floating enable
for_window [app_id="org.prismlauncher.PrismLauncher"] floating enable

# END
include /etc/sway/config.d/*
include ./config.d/*
