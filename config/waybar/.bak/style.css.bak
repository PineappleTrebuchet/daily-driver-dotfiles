@define-color font-color #e6e6e6;
@define-color black #0d0d0d;
@define-color grey #282828;
@define-color light-grey #464646;
@define-color red #ff0000;

* {
  font-family: "HackMonoNerdFont";
  font-size: 18px;
}

window#waybar { 
  background-color: @black; 
  color: @font-color;
	border-right: 1px solid @grey;
}

tooltip {
	border-radius: 0px;
	border: none;
}

#workspaces {
	margin: 0px 0px 0px 0px;
	padding: 0px 0px;
}

#workspaces button {
	transition: none;
	background: transparent;
	border: none;
	padding: 2px 0px 2px 0px;
 	min-height: 12px;
	color: @font-color;
	border-radius: 0px;
}

#workspaces button.focused { 
	background-color: @grey;
	color: @font-color;
	border-radius: 0px;
}
#workspaces button.urgent{
	color: @red;
}

/*kys default hover effects*/
#workspaces button:hover {
	box-shadow: inherit;
	text-shadow: inherit;
	transition: none;
	border-radius: 0px;
}

#mode {
	color: @red;
	margin: 6px 0px;
}

#power-profiles-daemon, #network, #backlight,
#pulseaudio, #battery, #cpu, #memory,
#temperature, #custom-weather, #clock, #idle_inhibitor {
	margin: 14px 0px 14px 0px;
}

#clock {
	margin: 10px 0px;
}

#tray {
	margin: 6px 0px;
}

#idle_inhibitor {
	color: @light-grey;
}
#idle_inhibitor.activated {
	color: @font-color;
}

#scratchpad {
  padding: 4px 0px;
}

#window {
  padding: 0px 6px 0px 4px;
}

#power-profiles-daemon.performance {
	color: #ff8c1a;
}
#power-profiles-daemon.power-saver {
	color: #00ff00;
}

#battery.critical:not(.charging), #network.disconnected, #pulseaudio.muted, #temperature.critical {
  color: @red;
}
